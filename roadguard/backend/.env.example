# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# SQLite database file path (default: repo root detections.db)
# On Render with a persistent disk mounted at /data, set this to:
# DATABASE_URL=/data/detections.db
DATABASE_URL=

# Optional: override model file path
# MODEL_PATH=/path/to/road_damage.pt
MODEL_PATH=
